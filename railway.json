{
  "$schema": "https://railway.com/railway.schema.json",
  "deploy": {
    "startCommand": "ANTRE_CONFIG_DIR=/tmp/antre/config ANTRE_DATA_DIR=/tmp/antre ANTRE_DEPLOY_PLATFORM=railway antre --bind 0.0.0.0 --port $PORT --no-tls",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 5,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
