---
import "@fontsource-variable/geologica/wght.css"
import "@fontsource-variable/atkinson-hyperlegible-next/wght.css"
import "@fontsource-variable/atkinson-hyperlegible-next/wght-italic.css"
import "@fontsource-variable/atkinson-hyperlegible-mono/wght.css"
import "../styles/global.css"
import { withBase } from "../lib/docs"

interface Props {
  title: string
  description?: string
}

const { title, description = "Documentation for Antre, a secure persistent personal agent server." } = Astro.props
---

<!doctype html>
<html lang="en" data-theme="light" data-theme-choice="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f7f7" />
    <title>{title}</title>
    <script is:inline>
      const storedTheme = localStorage.getItem('antre-site-theme') || 'auto'
      const media = window.matchMedia('(prefers-color-scheme: dark)')
      const resolvedTheme = storedTheme === 'auto' ? (media.matches ? 'dark' : 'light') : storedTheme
      document.documentElement.dataset.theme = resolvedTheme
      document.documentElement.dataset.themeChoice = storedTheme
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', resolvedTheme === 'dark' ? '#0d1214' : '#f5f7f7')
    </script>
    <link rel="icon" href={withBase("/antre-icon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
